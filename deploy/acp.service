[Unit]
Description=ACP (agent-compression-protocol) standalone ingress
After=network.target aalp.service
Wants=aalp.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=%h/agent-compression-protocol
Environment=PYTHONPATH=%h/agent-compression-protocol
Environment=ACP_HOME=%h/agent-compression-protocol
Environment=AALP_HOME=%h/agent-api-lane-protocol
ExecStart=/usr/bin/python3 -m acp --aalp-root %h/agent-api-lane-protocol --root %h/agent-compression-protocol

[Install]
WantedBy=default.target
